# Local state: SQLite database, session files, and collection history.
# SNOWDROP_DATA_DIR=/absolute/path/to/snowdrop-data

# Telegram's public web collector needs no credentials.
# Account mode uses your own application from https://my.telegram.org.
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_SESSION_FILE=/absolute/path/to/telegram.session

# Twikit-format JSON containing your own X session's auth_token and ct0.
# X_COOKIES_FILE=/absolute/path/to/x-cookies.json

# Optional Netscape-format cookies for YouTube requests requiring sign-in.
# YOUTUBE_COOKIES_FILE=/absolute/path/to/youtube-cookies.txt
